<script>window.ERN_CONFIG = { planList: {{ section.settings.plan_list | default: "" | json }} };</script>
<script src="{{ 'plan.js' | asset_url }}" defer></script>
<script src="{{ 'ern.js' | asset_url }}" defer></script>
<script>document.addEventListener('DOMContentLoaded', function(){
(function(){
  var $ = function(id){ return document.getElementById(id); };
  $('wlForm').addEventListener('submit', function(e){
    e.preventDefault();
    var email = $('wl-email').value.trim(), err = $('wl-err');
    if (!ERN.validEmail(email)) { err.textContent = 'Add your email to join the waitlist.'; err.style.display = 'block'; return; }
    err.style.display = 'none';
    var btn = this.querySelector('button'); btn.disabled = true; btn.textContent = 'Adding you…';
    ERN.subscribe('waitlistList', { email: email, properties: { bar_waitlist: true } }, 'Bar page').then(function(){
      $('wlForm').hidden = true; $('wlDone').hidden = false;
    }).catch(function(){
      btn.disabled = false; btn.innerHTML = 'Put me on the waitlist <span class="arr">→</span>';
      err.textContent = "That didn't go through. Try again in a minute."; err.style.display = 'block';
    });
  });
  ERN.sticky('join', 'wlDone');
})();
});</script>

