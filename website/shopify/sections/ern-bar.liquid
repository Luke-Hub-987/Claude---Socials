  </div>
</footer>

<div class="stick"><a class="btn" href="#join">Join the waitlist <span class="arr">→</span></a></div>
</div>

<script>window.ERN_CONFIG = { planList: {{ section.settings.plan_list | default: "" | json }}, waitlistList: {{ section.settings.waitlist_list | default: "" | json }}, resultsList: {{ section.settings.results_list | default: "" | json }} };</script>
<script src="{{ 'plan.js' | asset_url }}"></script>
<script src="{{ 'ern.js' | asset_url }}"></script>
<script>
(function(){
  var $ = function(id){ return document.getElementById(id); };
  $('wlForm').addEventListener('submit', function(e){
    e.preventDefault();
    var name = $('wl-name').value.trim(), email = $('wl-email').value.trim(), err = $('wl-err');
    if (!name || !ERN.validEmail(email)) { err.textContent = 'Add your first name and email.'; err.style.display = 'block'; return; }
    err.style.display = 'none';
    var btn = this.querySelector('button'); btn.disabled = true; btn.textContent = 'Adding you…';
    ERN.subscribe('waitlistList', { email: email, first_name: name, properties: { bar_waitlist: true } }, 'Bar page').then(function(){
      $('wlForm').hidden = true; $('wlDone').hidden = false;
    }).catch(function(){
      btn.disabled = false; btn.innerHTML = 'Put me on the waitlist <span class="arr">→</span>';
      err.textContent = "That didn't go through. Try again in a minute."; err.style.display = 'block';
    });
  });
  ERN.sticky('join', 'wlDone');
})();
</script>

