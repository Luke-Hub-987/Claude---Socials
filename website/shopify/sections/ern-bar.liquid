      {%- if section.settings.graveyard_4 -%}<figure><div class="slot">{{ section.settings.graveyard_4 | image_url: width: 500 | image_tag: loading: "lazy" }}</div><figcaption>Ep. 4</figcaption></figure>{%- endif -%}
    </div>
