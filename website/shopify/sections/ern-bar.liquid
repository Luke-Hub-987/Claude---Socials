<div class="ern">

<header class="top">
  <div class="wrap">
    <a class="logo" href="/" aria-label="Engine Room Nutrition home"><img src="{{ 'ern-logo.png' | asset_url }}" alt="ERN Engine Room Nutrition"></a>
