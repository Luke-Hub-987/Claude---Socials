.ern .rules{background:var(--cream);border-radius:14px;padding:16px 18px;margin-top:30px;font-size:15px}
.ern .rules p{margin:0 0 8px}.ern .rules p:last-child{margin:0}
.ern .actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
.ern .actions .btn{flex:1 1 200px}
.ern .inbox-note{margin-top:18px;border:2px solid #FFE58A;background:#FFFBEA;border-radius:14px;padding:16px 18px;font-size:15px}
