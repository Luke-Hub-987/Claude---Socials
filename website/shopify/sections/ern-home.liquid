.ern .tally b{display:block;font:400 clamp(40px,5vw,58px)/1 var(--fs);color:var(--blue)}
.ern .tally span{font:700 15px var(--fd);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-2)}

/* results wall */
.ern .wall{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:48px}
@media (max-width:960px){.ern .wall{grid-template-columns:1fr 1fr}}
