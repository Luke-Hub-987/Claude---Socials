{%- for block in section.blocks -%}{%- if block.type == 'message' and block.settings.text != blank -%}
{%- assign p = block.settings.platform -%}
{%- capture who -%}{%- if block.settings.name != blank -%}{{ block.settings.name }}{%- elsif block.settings.label != blank -%}{{ block.settings.label }}{%- else -%}{%- case p -%}{%- when 'gmail' -%}Gmail{%- when 'tiktok' -%}TikTok{%- else -%}Instagram{%- endcase -%}{%- endif -%}{%- endcapture -%}
{%- capture app -%}{%- case p -%}{%- when 'gmail' -%}Gmail{%- when 'tiktok' -%}TikTok{%- else -%}Instagram{%- endcase -%}{%- endcapture -%}
{%- if block.settings.name != blank -%}{%- assign initial = block.settings.name | slice: 0 | upcase -%}{%- else -%}{%- assign initial = '★' -%}{%- endif -%}
      <div class="msg msg-{{ p }} rv" {{ block.shopify_attributes }}><div class="msg-res"><b>{{ block.settings.result | escape }}</b><span>{{ block.settings.detail | escape }}</span></div><div class="msg-app">
      {%- if p == 'gmail' -%}<div class="gtop"><span class="gm"><i style="color:#EA4335">M</i></span>Inbox</div><div class="msg-head"><i class="av">{{ initial }}</i><div><b>{{ who | escape }}</b><small>to Luke</small></div></div>
      {%- else -%}<div class="msg-head"><i class="av">{{ initial }}</i><div><b>{{ who | escape }}</b><small>{{ app }}</small></div><span class="app">{{ app }}</span></div>{%- endif -%}
      <div class="msg-body">{%- assign lines = block.settings.text | newline_to_br | split: '<br />' -%}{%- for l in lines -%}{%- assign t = l | strip -%}{%- if t != blank -%}<p class="bub">{{ t | escape }}</p>{%- endif -%}{%- endfor -%}</div></div></div>
{%- endif -%}{%- endfor -%}

    </div>
    <div class="label rv tellus" id="tell-us">
      <div class="band">Ran with our plan? Tell us your time</div>
      <div class="body">
        <p style="margin:0 0 14px"><b>Dublin, Frankfurt, New York:</b> we want to hear how it went, good or bad. We read every one, and the best days end up on this wall (only with your OK).</p>
        <form id="resForm" novalidate>
          <div class="row2">
            <div class="field"><label class="f" for="rs-race">Race</label><input id="rs-race" type="text" placeholder="e.g. Dublin 2026"></div>
            <div class="field"><label class="f" for="rs-time">Finish time</label><input id="rs-time" type="text" inputmode="numeric" placeholder="e.g. 3:41:20"></div>
          </div>
          <div class="row2">
            <div class="field"><label class="f" for="rs-pb">PB by how much? <span class="muted" style="font-weight:400">(optional)</span></label><input id="rs-pb" type="text" placeholder="e.g. 12 minutes"></div>
            <div class="field"><label class="f" for="rs-email">Email</label><input id="rs-email" type="email" autocomplete="email" inputmode="email"></div>
          </div>
          <label class="chk"><input type="checkbox" id="rs-share"> You can share my first name and result on this page</label>
          <button class="btn" type="submit" style="margin-top:14px">Send my result</button>
          <div class="err" id="rs-err"></div>
        </form>
        <p id="rs-done" hidden style="margin:0"><b>Brilliant, thank you.</b> Luke reads every one of these.</p>
      </div>
