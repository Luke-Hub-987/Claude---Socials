.ern .hero .lede{margin:20px 0 26px}
.ern .proofrow{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:26px}
.ern .stat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:10px 14px;box-shadow:0 4px 14px -8px rgba(10,23,41,.2)}
.ern .stat b{display:block;font:800 26px/1 var(--fd);color:var(--blue)}
