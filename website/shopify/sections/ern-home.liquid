<script>window.ERN_CONFIG = { planList: {{ section.settings.plan_list | default: "" | json }}, waitlistList: {{ section.settings.waitlist_list | default: "" | json }}, resultsList: {{ section.settings.results_list | default: "" | json }} };</script>
<script src="{{ 'plan.js' | asset_url }}"></script>
<script src="{{ 'ern.js' | asset_url }}"></script>
<script>
(function(){
  var $ = function(id){ return document.getElementById(id); };
  var NS = 'http://www.w3.org/2000/svg';

  // goal options: 3:00 to 5:30
  var goal = $('pf-goal'), opts = '<option value="">Pick your goal</option>';
  for (var m = 180; m <= 330; m += 5) {
    var t = Math.floor(m/60) + ':' + ('0' + m%60).slice(-2);
    opts += '<option' + (t === '3:45' ? ' selected' : '') + '>' + t + '</option>';
    if (m === 240) opts += '<option>3:59 (sub-4)</option>';
  }
  goal.innerHTML = opts + '<option>Not sure yet</option>';
  $('pf-race').addEventListener('change', function(){ $('pf-other-wrap').hidden = this.value !== 'Other'; });

  // the race clock: drag to a goal, the 10K sign time is free, the rest blurred
  var slider = $('pf-slider'), notsure = $('pf-notsure'), slid = false;
  function fromSlider(){
    var m = +slider.value, t = Math.floor(m / 60) + ':' + ('0' + m % 60).slice(-2);
    goal.value = m === 240 ? '3:59 (sub-4)' : t;
    $('gpTime').textContent = m === 240 ? '3:59' : t;
    $('clockTag').textContent = m === 240 ? 'Sub-4' : 'Goal';
    slider.style.setProperty('--p', ((m - 180) / 150 * 100) + '%');
    var p = ERNPlan.build(ERNPlan.parseGoal(goal.value));
    ['sp10', 'sp20', 'sp30', 'sp40'].forEach(function(id, i){ $(id).textContent = p.signs[i]; });
  }
  slider.addEventListener('input', function(){ if (!slid) { slid = true; ERN.track('goal_slider_used'); } fromSlider(); });
  notsure.addEventListener('change', function(){
    $('get-plan').classList.toggle('off', this.checked);
    if (this.checked) goal.value = 'Not sure yet'; else fromSlider();
  });
  fromSlider();
  var started = false;
  $('planForm').addEventListener('focusin', function(){ if (!started) { started = true; ERN.track('plan_form_started'); } });

  // marquee
  var words = ['Your time at every 10K sign', 'Km and miles', '30g of carbs on the clock', '1M+ views', 'Made in Ireland', 'Free, on screen'];
  var s = words.map(function(w){ return '<span>' + w + '</span><span>✦</span>'; }).join('');
  $('marq').innerHTML = s + s;

  // count-up numbers in the proof tally
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(es){ es.forEach(function(e){
      if (!e.isIntersecting) return; io.unobserve(e.target);
      var el = e.target, end = +el.getAttribute('data-count'), t0 = performance.now();
      (function tick(now){ var k = Math.min(1, (now - t0) / 1200); el.textContent = Math.round(end * (1 - Math.pow(1 - k, 3))).toLocaleString('en-IE') + (el.getAttribute('data-suffix') || ''); if (k < 1) requestAnimationFrame(tick); })(t0);
    }); });
    document.querySelectorAll('[data-count]').forEach(function(el){ io.observe(el); });
  } else document.querySelectorAll('[data-count]').forEach(function(el){ el.textContent = (+el.getAttribute('data-count')).toLocaleString('en-IE'); });

  // ---- sign-up -> plan on screen ----
  var saved = null, plan = null, raceName = '';
  function renderPlan(p, race, name, email){
    var g = ERNPlan.label(p.goal);
    $('planKicker').textContent = (name ? name + ', here' : 'Here') + "'s your plan";
    $('planTitle').textContent = g + ' at ' + race;
    $('planSub').textContent = 'Finishes around ' + p.finish + ' if your watch reads 1% long, which leaves time in hand.' + (p.walk ? ' It includes walking every drink station, about 20 seconds each.' : '');
    $('planSigns').innerHTML = ['10K','20K','30K','40K'].map(function(k, i){ return '<div class="sign"><small>' + k + ' sign</small><strong>' + p.signs[i] + '</strong></div>'; }).join('');
    $('planStages').innerHTML = p.stages.map(function(st){ return '<tr><td>' + st.name + '</td><td><b>' + st.km + ' /K</b><div class="mi">' + st.mi + ' /mi</div></td><td>' + st.talk + '</td></tr>'; }).join('');
    $('planGels').innerHTML = p.gels.map(function(t){
      var a = t.split(':'), sec = (+a[0] * 60 + +a[1]) * 60;
      return '<div class="g" style="left:' + (4 + 88 * sec / p.finishSec) + '%"><span>' + t + '</span></div>';
    }).join('') + '<div class="end">FINISH</div>';
    $('planCarry').textContent = 'Carry ' + p.carry + ' gels, including one spare. Using 40g gels? One every 40 minutes instead.';
    $('planEmail').textContent = email;
  }
  function showNotSure(name){
    $('planKicker').textContent = name ? name + ", you're in" : "You're in";
    $('planTitle').textContent = "Let's find your goal";
    $('planSub').textContent = 'Reply to our email with your last half marathon time and Luke will work out a marathon goal with you. Then come back and pick it here.';
    ['planSigns','planStages','planGels','planCarry'].forEach(function(id){ $(id).innerHTML = ''; });
    document.querySelector('.ern .stages').hidden = true;
    document.querySelector('.ern .rules').hidden = true; document.querySelector('.ern .actions').hidden = true;
  }

  $('planForm').addEventListener('submit', function(e){
    e.preventDefault();
    raceName = $('pf-race').value === 'Other' ? ($('pf-other').value.trim() || 'your race') : $('pf-race').value;
    var name = '', email = $('pf-email').value.trim(), gv = goal.value, err = $('pf-err');
    if (!$('pf-race').value || !gv) { err.textContent = 'Pick your race and goal time first.'; err.style.display = 'block'; return; }
    if (!ERN.validEmail(email)) { err.textContent = 'Add your email to unlock your plan.'; err.style.display = 'block'; return; }
    err.style.display = 'none';
    var btn = this.querySelector('button'); btn.disabled = true; btn.textContent = 'Building your plan…';
    var gs = ERNPlan.parseGoal(gv);
    plan = gs ? ERNPlan.build(gs) : null;
    var props = { race: raceName, goal_time: gv, plan_requested_at: new Date().toISOString() };
    if (plan) {
      props.plan_10k = plan.signs[0]; props.plan_20k = plan.signs[1]; props.plan_30k = plan.signs[2]; props.plan_40k = plan.signs[3];
      props.plan_pace_1 = plan.stages[0].km + ' /K (' + plan.stages[0].mi + ' /mi)';
      props.plan_pace_2 = plan.stages[1].km + ' /K (' + plan.stages[1].mi + ' /mi)';
      props.plan_pace_3 = plan.stages[2].km + ' /K (' + plan.stages[2].mi + ' /mi)';
      props.plan_gels = plan.gels.join(', '); props.plan_carry = plan.carry; props.plan_finish = plan.finish;
    }
    saved = { email: email, properties: props }; if (name) saved.first_name = name;
    var done = function(){
      $('planForm').hidden = true;
      if (plan) renderPlan(plan, raceName, name, email); else showNotSure(name);
      $('plan').hidden = false;
      $('get-plan').scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    // the value never waits on the network: if Klaviyo fails, they still get the plan
    ERN.subscribe('planList', saved, 'Pace plan page').then(done, done);
    ERN.track('plan_unlocked', { email: email, goal_time: gv, race: raceName });
  });

  // lock screen image: a phone-sized PNG of the plan
  $('saveLock').addEventListener('click', function(){
    (document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()).then(drawLock);
  });
  function drawLock(){
    var W = 1170, H = 2532, c = document.createElement('canvas'); c.width = W; c.height = H;
    var x = c.getContext('2d'), p = plan;
    x.fillStyle = '#2485E6'; x.fillRect(0, 0, W, H);
    x.fillStyle = '#fff'; x.textAlign = 'center';
    x.font = '700 54px "Barlow Condensed", sans-serif';
    x.fillText((raceName + ' · goal ' + ERNPlan.label(p.goal)).toUpperCase(), W/2, 980);
    ['10K','20K','30K','40K'].forEach(function(k, i){
      var y = 1140 + i * 230;
      x.fillStyle = 'rgba(255,255,255,.16)'; x.fillRect(150, y - 150, W - 300, 200);
      x.fillStyle = '#fff'; x.textAlign = 'left'; x.font = '800 70px "Barlow Condensed", sans-serif'; x.fillText(k, 200, y - 30);
      x.textAlign = 'right'; x.font = '800 150px "Barlow Condensed", sans-serif'; x.fillText(p.signs[i], W - 200, y);
    });
    x.textAlign = 'center'; x.font = '600 46px Inter, sans-serif';
    x.fillText('Watch: ' + p.stages[0].km + ' to 10K, then ' + p.stages[1].km, W/2, 2100);
    x.fillText('Gels: ' + p.gels.join('  '), W/2, 2180);
    x.font = 'italic 800 48px "Barlow Condensed", sans-serif'; x.fillText('ERN · ENGINE ROOM NUTRITION', W/2, 2330);
    ERN.track('lock_screen_saved');
    // show it on the page: press and hold saves it to Photos on a phone
    var url = c.toDataURL('image/png'), box = $('lockBox');
    box.querySelector('img').src = url;
    box.querySelector('a').href = url;
    box.hidden = false;
  }
  $('lockBox').addEventListener('click', function(e){ if (e.target === this || e.target.hasAttribute('data-close')) this.hidden = true; });

  // printable pace band: 4 strips to cut out and tape round your wrist
  $('printBand').addEventListener('click', function(){
    var p = plan, row = '<div class="strip"><table><tr><td><b>' + raceName + ' ' + ERNPlan.label(p.goal) + '</b></td>' +
      p.signs.map(function(s, i){ return '<td>' + (i + 1) * 10 + 'K <b>' + s + '</b></td>'; }).join('') + '</tr><tr><td colspan="5">Watch ' + p.stages[0].km + ' to 10K · ' + p.stages[1].km + ' to 40K · last 2K ' + p.stages[2].km + ' · Gels ' + p.gels.join(' ') + '</td></tr></table></div>';
    $('ern-band').innerHTML = row + row + row + row;
    ERN.track('pace_band_printed');
    window.print();
  });

  // the second yes: separate consent for the bar waitlist
  $('wlYes').addEventListener('click', function(){
    this.disabled = true;
    ERN.track('waitlist_yes', { email: saved.email, from: 'plan' });
    ERN.subscribe('waitlistList', { email: saved.email, properties: { bar_waitlist: true } }, 'Pace plan thank-you')
      .then(function(){ $('wlAsk').hidden = true; $('wlThanks').hidden = false; });
  });
  $('wlNo').addEventListener('click', function(){ $('wlAsk').hidden = true; });

  // bar waitlist straight from the home page
  $('barForm').addEventListener('submit', function(e){
    e.preventDefault();
    var email = $('bf-email').value.trim(), err = $('bf-err');
    if (!ERN.validEmail(email)) { err.textContent = 'Add your email to join the waitlist.'; err.style.display = 'block'; return; }
    err.style.display = 'none'; this.querySelector('button').disabled = true;
    ERN.track('waitlist_yes', { email: email, from: 'home bar section' });
    ERN.subscribe('waitlistList', { email: email, properties: { bar_waitlist: true } }, 'Home bar section').then(function(){
      document.querySelector('#barForm .inline').hidden = true; $('bf-done').hidden = false;
    });
  });

  // results after race day: the wall refills itself (shared only with consent)
  $('resForm').addEventListener('submit', function(e){
    e.preventDefault();
    var email = $('rs-email').value.trim(), race = $('rs-race').value.trim(), time = $('rs-time').value.trim(), err = $('rs-err');
    if (!race || !time || !ERN.validEmail(email)) { err.textContent = 'Add your race, your time and your email.'; err.style.display = 'block'; return; }
    err.style.display = 'none'; this.querySelector('button').disabled = true;
    var props = { result_race: race, result_time: time, result_pb: $('rs-pb').value.trim(), result_share_ok: $('rs-share').checked, result_sent_at: new Date().toISOString() };
    ERN.track('result_submitted', Object.assign({ email: email }, props));
    var fin = function(){ $('resForm').hidden = true; $('rs-done').hidden = false; };
    ERN.subscribe('resultsList', { email: email, properties: props }, 'Results form').then(fin, fin);
  });

  ERN.sticky('get-plan', 'plan');
})();
</script>

