.ern .gelbar .g span{position:absolute;bottom:32px;left:50%;transform:translateX(-50%);font:700 12px var(--fd);color:var(--ink-2);white-space:nowrap}
.ern .gelbar .g:nth-child(even) span{bottom:auto;top:32px}
