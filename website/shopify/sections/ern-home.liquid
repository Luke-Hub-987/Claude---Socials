.ern .pbtag{position:absolute;top:-14px;right:16px;background:#2DBE6C;color:#fff;font:800 16px var(--fd);letter-spacing:.06em;text-transform:uppercase;padding:7px 12px;border-radius:999px;transform:rotate(4deg);box-shadow:0 8px 18px -8px rgba(0,0,0,.4)}
.ern .tally{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:56px;text-align:center}
