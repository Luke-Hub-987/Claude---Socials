.ern .msgs{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:48px;align-items:start}
@media (max-width:960px){.ern .msgs{grid-template-columns:1fr;max-width:520px;margin-left:auto;margin-right:auto}}
.ern .phone{background:#fff;border-radius:28px;border:1px solid var(--line);box-shadow:0 30px 60px -30px rgba(10,23,41,.35);padding:16px;position:relative}
.ern .phone .from{display:flex;align-items:center;gap:10px;font:600 14px var(--fb);color:var(--ink-2);margin-bottom:12px}
