.ern .rcard{background:var(--cream);border-radius:22px;padding:22px 24px;border:1px solid var(--line);transition:transform .2s,box-shadow .2s}
.ern .rcard:hover{transform:translateY(-4px) rotate(-.4deg);box-shadow:0 24px 50px -24px rgba(10,23,41,.35)}
.ern .rcard.feature{background:#2DBE6C;color:#fff;border-color:#2DBE6C}
