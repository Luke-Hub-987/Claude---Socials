.ern .inbox-note ul{margin:8px 0 0;padding-left:18px}
.ern .inbox-note li{margin-bottom:4px}
.ern .wl{margin-top:18px;border-radius:16px;overflow:hidden;display:grid;grid-template-columns:120px 1fr;background:var(--blue-lt)}
