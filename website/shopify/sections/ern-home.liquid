}
/* v5: goal slider in the thumb zone */
.ern .goalpick{background:var(--blue-lt);border-radius:16px;padding:14px 16px 12px;margin-bottom:16px}
.ern .gp-read{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin:2px 0 6px}
