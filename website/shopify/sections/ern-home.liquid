.ern .tellus{max-width:760px;margin:48px auto 0}
.ern .tellus .band{background:#2DBE6C}.ern .tellus .band:after{background:#2DBE6C}
/* lock screen viewer */
.ern .lockbox{position:fixed;inset:0;z-index:60;background:rgba(10,23,41,.8);display:grid;place-items:center;padding:16px}
