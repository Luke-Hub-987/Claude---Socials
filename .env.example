# Copy this file to .env and fill in real values. .env is gitignored.

# YouTube Data API v3 — Google Cloud Console > APIs & Services > Credentials
# Enable "YouTube Data API v3" on the project first. Free tier: 10,000 units/day.
YOUTUBE_API_KEY=

# Apify — https://console.apify.com/account/integrations (API token)
# Used to run both the Instagram scraper (ig_outliers.py) and the
# Reddit scraper (reddit_scan.py, via trudax/reddit-scraper-lite).
# No separate Reddit credential needed: Reddit's current developer
# signup rules made an OAuth app hard to get approved, and even
# Reddit's public unauthenticated endpoints return a 403 straight from
# Reddit's own servers when called directly from a datacenter IP
# (confirmed, not a guess) — the Apify actor routes around both.
APIFY_API_TOKEN=
