# Copy this file to .env and fill in real values. .env is gitignored.

# YouTube Data API v3 — Google Cloud Console > APIs & Services > Credentials
# Enable "YouTube Data API v3" on the project first. Free tier: 10,000 units/day.
YOUTUBE_API_KEY=

# Reddit — no developer app needed. reddit_scan.py uses Reddit's public
# unauthenticated JSON endpoints (reddit.com/r/<sub>/top.json), since
# Reddit's current developer signup rules can be hard to clear for a
# small personal project. Reddit does reject generic/default user
# agents, so set a real descriptive one:
REDDIT_USER_AGENT=engine-room-ideate/0.1 (personal research use)

# Apify — https://console.apify.com/account/integrations (API token)
# Used to run an Instagram scraping actor. Free tier included.
APIFY_API_TOKEN=
