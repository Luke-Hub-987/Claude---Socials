# Copy this file to .env and fill in real values. .env is gitignored.

# YouTube Data API v3 — Google Cloud Console > APIs & Services > Credentials
# Enable "YouTube Data API v3" on the project first. Free tier: 10,000 units/day.
YOUTUBE_API_KEY=

# Reddit API — https://www.reddit.com/prefs/apps > create app > type "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=engine-room-ideate/0.1 by u/your-reddit-username

# Apify — https://console.apify.com/account/integrations (API token)
# Used to run an Instagram scraping actor. Free tier included.
APIFY_API_TOKEN=
